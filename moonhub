                                    end
                                end
                                if gui:IsA("TextButton") then
                                    textCombined = textCombined .. " " .. string.lower(gui.Text)
                                end

                                if operatesReplay then
                                    if textCombined:find("replay") or textCombined:find("retry") or textCombined:find("again") or textCombined:find("tekrar") then
                                        local btnToClick = gui:IsA("TextButton") or gui:IsA("ImageButton") and gui or gui:FindFirstAncestorOfClass("TextButton") or gui:FindFirstAncestorOfClass("ImageButton")
                                        if btnToClick then ForceClickButton(btnToClick) end
                                    end
                                    if textCombined == "yes" or textCombined == "evet" or textCombined:find("confirm") or textCombined:find("accept") then
                                        local btnToClick = gui:IsA("TextButton") or gui:IsA("ImageButton") and gui or gui:FindFirstAncestorOfClass("TextButton") or gui:FindFirstAncestorOfClass("ImageButton")
                                        if btnToClick then ForceClickButton(btnToClick) end
                                    end
                                end

                                if _G.AutoStartDungeon then
                                    if textCombined:find("start") or textCombined:find("ready") or textCombined:find("başla") then
                                        local btnToClick = gui:IsA("TextButton") or gui:IsA("ImageButton") and gui or gui:FindFirstAncestorOfClass("TextButton") or gui:FindFirstAncestorOfClass("ImageButton")
                                        if btnToClick then ForceClickButton(btnToClick) end
                                    end
                                end
                            end
                        end
                    end

                    if operatesReplay then
                        local remotes = ReplicatedStorage:FindFirstChild("remotes") or ReplicatedStorage:FindFirstChild("Remotes")
                        if remotes then
                            for _, remote in pairs(remotes:GetChildren()) do
                                if remote:IsA("RemoteEvent") then
