                char.Humanoid.WalkSpeed = _G.WalkSpeed or 32
                
                local hrpPos = char.HumanoidRootPart.Position
                local nearGround = IsGroundBelow(hrpPos)
                
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        if nearGround and not isOverheading then
                            if part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" then
                                part.CanCollide = true
                            end
                        else
                            if _G.Noclip or isOverheading then
                                part.CanCollide = false
                            else
                                part.CanCollide = true
                            end
                        end
                    end
                end
            end
        end)
    end)

    OrionLib:Init()
end

