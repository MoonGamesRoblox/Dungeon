-- 🛡️ REAL-TIME EQUIPMENT SCANNER ENGINE
----------------------------------------------------
local function ForceEquipBestLogic()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("remotes") or ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes then return end

        local equipBestRemote = remotes:FindFirstChild("equipBest") or remotes:FindFirstChild("equipBestItems") or remotes:FindFirstChild("autoEquip")
        
        local classType = "Physical"
        if string.find(_G.SelectedClass, "Mage") then classType = "Spell"
        elseif string.find(_G.SelectedClass, "Tank") then classType = "Defense"
        elseif string.find(_G.SelectedClass, "Healer") then classType = "Healer" end

        if equipBestRemote then
            if equipBestRemote:IsA("RemoteEvent") then 
                equipBestRemote:FireServer(classType)
                equipBestRemote:FireServer()
            elseif equipBestRemote:IsA("RemoteFunction") then 
                equipBestRemote:InvokeServer(classType) 
                equipBestRemote:InvokeServer()
            end
        end

        local equipItemRemote = remotes:FindFirstChild("equipItem") or remotes:FindFirstChild("equip") or remotes:FindFirstChild("changeItem")
        local playerFolder = LocalPlayer:FindFirstChild("inventory") or LocalPlayer:FindFirstChild("Inventory") or ReplicatedStorage:FindFirstChild("playerData")

        if equipItemRemote and playerFolder then
            for _, item in pairs(playerFolder:GetChildren()) do
                if item:IsA("Folder") or item:IsA("Configuration") or item:IsA("IntValue") then
                    local itemType = item:FindFirstChild("Type") or item:FindFirstChild("itemType")
                    if itemType then
                        if equipItemRemote:IsA("RemoteEvent") then
                            equipItemRemote:FireServer(item)
                        elseif equipItemRemote:IsA("RemoteFunction") then
                            equipItemRemote:InvokeServer(item)
                        end
                    end
                end
            end
        end
    end)
end

