                                    isDodging = true
                                    local escapeDir = (myPos - obj.Position).Unit * 12
                                    char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(escapeDir.X, 0, escapeDir.Z)
                                    task.wait(0.2)
                                    isDodging = false
                                    break
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)

