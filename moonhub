                        for _, gui in pairs(playerGui:GetDescendants()) do
                            if gui:IsA("GuiObject") and gui.Visible then
                                local textCombined = string.lower(gui.Name)
                                
                                for _, child in pairs(gui:GetChildren()) do
                                    if child:IsA("TextLabel") then
