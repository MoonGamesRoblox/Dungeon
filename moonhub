    local function GetNearestEnemy()
        local nearest = nil
        local shortestDistance = math.huge
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

        local dungeonFolder = Workspace:FindFirstChild("dungeon") or Workspace:FindFirstChild("Dungeon") or Workspace:FindFirstChild("Monsters") or Workspace

        for _, obj in pairs(dungeonFolder:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                if obj.Name ~= LocalPlayer.Name and obj.Humanoid.Health > 0 then
                    local dist = (char.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearest = obj
                    end
                end
            end
        end
        return nearest
    end

    local lastMoveUpdate = 0
    local isDodging = false
    local isOverheading = false
    
    -- Pathfinding nesnesi ve değişkenleri
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        WaypointSpacing = 4
    })
    local currentWaypoints = {}
    local currentWaypointIndex = 1
    local lastPathCompute = 0

    RunService.Heartbeat:Connect(function()
        if _G.AutoKill and not isDodging then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    local target = GetNearestEnemy()
                    if target and target:FindFirstChild("HumanoidRootPart") then
                        local targetPos = target.HumanoidRootPart.Position
                        local myPos = char.HumanoidRootPart.Position
                        local dist = (myPos - targetPos).Magnitude

                        target.HumanoidRootPart.CanCollide = false

                        if dist > 8 then
                            isOverheading = false
                            
                            -- Akıllı Pathfinding (Duvarları aşma sistemi)
                            if os.clock() - lastPathCompute > 0.8 then
                                lastPathCompute = os.clock()
                                pcall(function()
                                    path:ComputeAsync(myPos, targetPos)
                                    if path.Status == Enum.PathStatus.Success then
                                        currentWaypoints = path:GetWaypoints()
                                        currentWaypointIndex = 2 -- İlk nokta genelde karakterin kendisidir
                                    else
                                        -- Yol hesaplanamazsa direkt MoveTo kullan
                                        currentWaypoints = {}
                                        char.Humanoid:MoveTo(targetPos)
                                    end
                                end)
                            end

                            if #currentWaypoints > 0 and currentWaypointIndex <= #currentWaypoints then
                                local waypoint = currentWaypoints[currentWaypointIndex]
                                if waypoint then
                                    char.Humanoid:MoveTo(waypoint.Position)
                                    if waypoint.Action == Enum.PathWaypointAction.Jump then
                                        char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                                    end
                                    
                                    -- Mevcut noktaya yaklaşıldıysa bir sonrakine geç
                                    if (myPos - waypoint.Position).Magnitude < 4 then
                                        currentWaypointIndex = currentWaypointIndex + 1
                                    end
                                end
                            else
                                if os.clock() - lastMoveUpdate > 0.15 then
                                    char.Humanoid:MoveTo(targetPos)
                                    lastMoveUpdate = os.clock()
                                end
                            end
                        else
                            isOverheading = true
                            currentWaypoints = {}
                            local overheadPos = targetPos + Vector3.new(0, _G.OverheadHeight or 3.5, 0)
                            char.HumanoidRootPart.CFrame = CFrame.new(overheadPos, targetPos)
                            
                            -- Yerçekimi ivmesini ve hızını tamamen sıfırla
                            char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                            char.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
                        end
                    else
                        isOverheading = false
                        currentWaypoints = {}
                    end
                end
            end)
        else
            isOverheading = false
            currentWaypoints = {}
        end
    end)

    -- ⚡ SMART AUTO DODGE ENGINE
    task.spawn(function()
