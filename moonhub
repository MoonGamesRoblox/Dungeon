-- 🔑 DYNAMIC 6-HOUR KEY & SAVE SYSTEM
----------------------------------------------------
local KeyFileName = "MoonHub_SaveData.json"
local DiscordKeyLink = "https://discord.gg/Hc5y6urXx3"
local SixHoursInSeconds = 6 * 3600

-- Her 6 saatte bir (00:00, 06:00, 12:00, 18:00 UTC) değişen Key algoritması
local function GetCurrentKey()
    local currentPeriod = math.floor(os.time() / SixHoursInSeconds)
    return "MOON-HUB-" .. tostring(currentPeriod)
end

local CorrectKey = GetCurrentKey()

-- Hafızadaki Key'i Kontrol Etme (6 Saat Doldu mu?)
local function CheckSavedKey()
    if isfile and readfile and isfile(KeyFileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(KeyFileName))
        end)
        
        if success and result and result.Key == CorrectKey then
            if (os.time() - (result.Time or 0)) < SixHoursInSeconds then
                return true
            end
        end
    end
    return false
end

-- Yeni Key'i Bilgisayara Kaydetme
local function SaveKey(enteredKey)
    if writefile then
        local data = {
            Key = enteredKey,
            Time = os.time()
        }
        pcall(function()
            writefile(KeyFileName, HttpService:JSONEncode(data))
        end)
    end
end

