-- 🔐 WEB SİTESİYLE BİREBİR AYNI HASH ALGORİTMASI
----------------------------------------------------
local function GenerateSecureToken(userId, timeBlock)
    local secretSalt = "MOON_SECURE_TOKEN_2026_V2"
    local rawString = tostring(userId) .. "_" .. tostring(timeBlock) .. "_" .. secretSalt
    
    local hash1 = 0
    fn_bit32_lshift = function(n, p) return math.floor(n * 2^p) % 4294967296 end

    local hash2 = 5381

    for i = 1, #rawString do
        local char = string.byte(rawString, i)
        
        -- JavaScript'teki bitwise "|" operatörünün Lua simülasyonu (32-bit signed int)
        local h1_calc = (hash1 * 32 - hash1) + char
        hash1 = h1_calc % 4294967296
        if hash1 >= 2147483648 then hash1 = hash1 - 4294967296 end
        
        local h2_calc = (hash2 * 32 + hash2) + char
        hash2 = h2_calc % 4294967296
        if hash2 >= 2147483648 then hash2 = hash2 - 4294967296 end
    end

    local part1 = string.format("%X", math.abs(hash1))
    local part2 = string.format("%X", math.abs(hash2))
    
    local chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    local num = tonumber(userId)
    local base36 = ""
    if num == 0 then
        base36 = "0"
    else
        while num > 0 do
            local remainder = (num % 36) + 1
            base36 = string.sub(chars, remainder, remainder) .. base36
            num = math.floor(num / 36)
        end
    end

    return "MOON-" .. string.sub(part1, 1, 4) .. "-" .. string.sub(part2, 1, 4) .. "-" .. base36
end

local function VerifyKey(enteredKey, isAutoLogin)
    if not enteredKey or enteredKey == "" then return false end
    local cleanInput = string.upper(enteredKey):gsub("%s+", "")
    
    if cleanInput == ADMIN_KEY then
        IsAdminSession = true
        return true
    end
    
    local currentTime = os.time()
    local blockDuration = 6 * 3600
    local currentBlock = math.floor(currentTime / blockDuration)
    
    -- Zaman kayması sorununu önlemek için şimdiki blok ve önceki/sonraki bloklar taranır
    for _, blockOffset in ipairs({0, -1, 1}) do
        local targetBlock = currentBlock + blockOffset
        local expectedToken = GenerateSecureToken(LocalPlayer.UserId, targetBlock)
        if cleanInput == expectedToken then
            return true
        end
    end
    
    return false
end

local function CheckSavedKey()
    if isfile and readfile and isfile(KeyFileName) then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(KeyFileName)) end)
        if success and result and result.Key and result.SavedAt then
            if (os.time() - result.SavedAt) <= KEY_VALID_TIME then
                if VerifyKey(result.Key, true) then return true end
            end
        end
    end
    return false
end

local function SaveKey(enteredKey)
    if writefile then
        pcall(function()
            writefile(KeyFileName, HttpService:JSONEncode({
                Key = string.upper(enteredKey):gsub("%s+", ""),
                UserId = LocalPlayer.UserId,
                SavedAt = os.time()
            }))
        end)
    end
end

