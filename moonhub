    local function GetDungeonMonsters()
        return Workspace:FindFirstChild("dungeon") or Workspace:FindFirstChild("Dungeon") or Workspace:FindFirstChild("Monsters") or Workspace
    end

    local function GetNearestEnemy()
        local nearest = nil
        local shortestDistance = math.huge
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

        local folder = GetDungeonMonsters()
        for _, obj in pairs(folder:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                if obj.Name ~= LocalPlayer.Name and obj.Humanoid.Health > 0 then
                    local dist = (char.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearest = obj
                    end
                end
            end
        end
        return nearest
    end

    local function AreMonstersAlive()
        local folder = GetDungeonMonsters()
        for _, obj in pairs(folder:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                if obj.Name ~= LocalPlayer.Name then
                    return true
                end
            end
        end
        return false
    end

    local lastCheckPos = Vector3.zero
    local stuckTicks = 0

    task.spawn(function()
        while task.wait(0.03) do
            if _G.AutoKill then
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                        local hum = char.Humanoid
                        local hrp = char.HumanoidRootPart

                        hum.AutoRotate = false

                        local target = GetNearestEnemy()
                        if target and target:FindFirstChild("HumanoidRootPart") then
                            local targetHrp = target.HumanoidRootPart
                            local targetPos = targetHrp.Position
                            local myPos = hrp.Position

                            local targetHeight = 3
                            if target:IsA("Model") then
                                targetHeight = target:GetExtentsSize().Y / 2
                            end
                            
                            local destinationAbove = targetPos + Vector3.new(0, targetHeight + 3, 0)

                            local flatLookTarget = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
                            if (flatLookTarget - myPos).Magnitude > 0.05 then
                                hrp.CFrame = CFrame.lookAt(myPos, flatLookTarget)
                            end

                            local horizDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
                            local maxDist = tonumber(_G.AttackDistance) or 8.5

                            if horizDist > maxDist then
                                hum:MoveTo(destinationAbove)

                                if (hrp.Position - lastCheckPos).Magnitude < 0.2 then
                                    stuckTicks = stuckTicks + 1
                                    if stuckTicks >= 6 then
                                        hum.Jump = true
                                        stuckTicks = 0
                                    end
                                else
                                    stuckTicks = 0
                                end
                                lastCheckPos = hrp.Position
                            else
                                hrp.CFrame = CFrame.new(destinationAbove, destinationAbove + hrp.CFrame.LookVector)
                            end
                        else
                            hum.AutoRotate = true
                        end
                    end
                end)
            end
        end
    end)

