    local function GetNearestEnemy()
        local nearest = nil
        local shortestDistance = math.huge
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

        local dungeonFolder = Workspace:FindFirstChild("dungeon") or Workspace:FindFirstChild("Dungeon") or Workspace:FindFirstChild("Monsters") or Workspace

        for _, obj in pairs(dungeonFolder:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                if obj.Name ~= LocalPlayer.Name and obj.Humanoid.Health > 0 then
                    local dist = (char.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearest = obj
                    end
                end
            end
        end
        return nearest
    end

