    local function ForceClickButton(btn)
        if btn and (btn:IsA("TextButton") or btn:IsA("ImageButton")) then
            pcall(function()
                for _, connection in pairs(getconnections(btn.MouseButton1Click)) do
                    connection:Fire()
                end
                for _, connection in pairs(getconnections(btn.Activated)) do
                    connection:Fire()
                end
                
                local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
            end)
        end
    end

    local dungeonFinishedTime = nil

    task.spawn(function()
        while task.wait(0.8) do
            pcall(function()
                local monstersAlive = AreMonstersAlive()

                if not monstersAlive and not dungeonFinishedTime then
                    dungeonFinishedTime = tick()
                elseif monstersAlive then
                    dungeonFinishedTime = nil
                end

                -- Wait 2.2 seconds after boss defeat for loot screen/rewards
                local operatesReplay = _G.AutoReplay and dungeonFinishedTime and (tick() - dungeonFinishedTime >= 2.2)

                if operatesReplay or _G.AutoStartDungeon then
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
