-- 🔑 LOOTLABS CONFIG & KEY ALGORITHM
----------------------------------------------------
local KeyFileName = "MoonHub_DynamicKeySave.json"
local LOOTLABS_LINK = "https://loot-link.com/s?5nfGFsob"

local function GenerateValidKeyForCurrentBlock()
    local timeBlock = math.floor(os.time() / (6 * 3600))
    local secret = "MOON_HUB_SECRET_SALT_2026"
    local str = tostring(timeBlock) .. secret
    
    local hash = 0
    for i = 1, #str do
        local char = string.byte(str, i)
        hash = (hash * 31 + char) % 4294967296
    end
    
    if hash > 2147483647 then
        hash = hash - 4294967296
    end
    
    local keyHex = string.format("%X", math.abs(hash))
    return "MOON-" .. keyHex
end

local function VerifyKey(enteredKey)
    if not enteredKey or enteredKey == "" then return false end
    local cleanInput = string.upper(string.gsub(enteredKey, "%s+", ""))
    return cleanInput == GenerateValidKeyForCurrentBlock()
end

local function CheckSavedKey()
    if isfile and readfile and isfile(KeyFileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(KeyFileName))
        end)
        
        if success and result and result.Key then
            if VerifyKey(result.Key) then
                return true
            end
        end
    end
    return false
end

local function SaveKey(enteredKey)
    if writefile then
        local data = {
            Key = enteredKey,
            SavedAt = os.time()
        }
        pcall(function()
            writefile(KeyFileName, HttpService:JSONEncode(data))
        end)
    end
end

