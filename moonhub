    local function GetBestDungeonData(playerLevel)
        if playerLevel >= 180 then return "Orbital Outpost", "Nightmare"
        elseif playerLevel >= 160 then return "Gilded Depths", "Nightmare"
        elseif playerLevel >= 140 then return "Volcanic Catacombs", "Nightmare"
        elseif playerLevel >= 120 then return "Aquatic Temple", "Nightmare"
        elseif playerLevel >= 105 then return "Unholy Sanctuary", "Nightmare"
        elseif playerLevel >= 90 then return "King's Castle", "Nightmare"
        elseif playerLevel >= 75 then return "Pirate Island", "Nightmare"
        elseif playerLevel >= 60 then return "Underworld", "Insane"
        elseif playerLevel >= 45 then return "Steampunk Sewers", "Hard"
        elseif playerLevel >= 30 then return "Winter Outpost", "Hard"
        elseif playerLevel >= 15 then return "Desert Temple", "Medium"
        else return "Desert Temple", "Easy" end
    end

    task.spawn(function()
